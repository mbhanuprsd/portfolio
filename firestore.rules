rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isVerifiedUser() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email is string;
    }

    function isAdmin() {
      return isVerifiedUser() && request.auth.token.admin == true;
    }

    function hasValidMessageFields() {
      return request.resource.data.keys().hasAll([
          'text', 'sender', 'isAdmin', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'text', 'sender', 'isAdmin', 'createdAt'
        ])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 5000
        && request.resource.data.sender is string
        && request.resource.data.isAdmin is bool
        && request.resource.data.createdAt == request.time;
    }

    match /chats/{chatId} {
      allow get, list: if isAdmin()
        || (isVerifiedUser() && resource.data.sender == request.auth.token.email);

      allow create: if hasValidMessageFields()
        && (
          (request.resource.data.isAdmin == true && isAdmin())
          || (
            request.resource.data.isAdmin == false
            && isVerifiedUser()
            && request.resource.data.sender == request.auth.token.email
          )
        );

      allow update, delete: if false;
    }
  }
}
